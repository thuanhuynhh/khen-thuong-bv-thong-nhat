{
  "name": "@thongnhat/desktop",
  "version": "1.0.4",
  "description": "Ứng dụng quản lý thành tích và khen thưởng Bệnh viện Thống Nhất",
  "author": "Bệnh viện Thống Nhất",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --dir",
    "typecheck": "tsc -b --pretty false",
    "release:win": "tsc -b && vite build && electron-builder --win --publish never",
    "publish:win": "tsc -b && vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@thongnhat/shared": "*",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "vn.gov.bvtn.khenthuong",
    "productName": "Khen thưởng BV Thống Nhất",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KhenThuong-ThongNhat-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Khen thưởng BV Thống Nhất"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thuanhuynhh",
        "repo": "khen-thuong-bv-thong-nhat",
        "releaseType": "release"
      }
    ]
  }
}
