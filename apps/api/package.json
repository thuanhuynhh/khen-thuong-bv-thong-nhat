{
  "name": "@thongnhat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply thong-nhat-rewards --local",
    "db:migrate:remote": "wrangler d1 migrations apply thong-nhat-rewards --remote"
  },
  "dependencies": {
    "@thongnhat/shared": "*",
    "hono": "^4.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "wrangler": "^4.120.1"
  }
}
